# ==============================================================================
# 📦 WAREHOUSE INVENTORY MANAGEMENT PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# In production on Hostinger, configure these environment variables in your VPS
# or Hostinger Cloud Node.js environment panel.
# DO NOT commit real passwords, secrets, or API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# The public URL where the application is hosted
# Example: https://your-domain.com or https://portal.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Comma-separated list of allowed CORS origins if accessing across domains
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ------------------------------------------------------------------------------
# 🗄️ DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=public&sslmode=prefer
#
# Examples:
# - Local PostgreSQL: postgresql://postgres:password@localhost:5432/warehouse_db?schema=public
# - Hostinger VPS PostgreSQL: postgresql://warehouse_user:YourStrongPassword@127.0.0.1:5432/warehouse_db?schema=public
# - Neon DB / Supabase: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/warehouse_db?schema=public"

# Database connection pool maximum clients (default: 10)
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret string used to sign and verify JWT authentication cookies.
# Generate a strong 32+ character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_generate_a_random_string_here_32_chars

# ------------------------------------------------------------------------------
# 📩 EMAIL / SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Standard Hostinger SMTP (Recommended for Hostinger domains)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=YourHostingerEmailPassword
SMTP_FROM="Warehouse Portal <noreply@yourdomain.com>"

# Option B: Gmail App Password (Alternative)
# EMAIL_USER=yourgmail@gmail.com
# EMAIL_PASS=your_16_character_google_app_password
# EMAIL_FROM="Warehouse Portal <yourgmail@gmail.com>"

# ------------------------------------------------------------------------------
# ☁️ FILE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Cloudinary (Cloud-persistent storage - Recommended for cloud scaling)
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Option B: Persistent Local Storage (Fallback if Cloudinary is not configured)
# Uploaded files will be stored in public/uploads by default, or the custom path below.
# UPLOAD_DIR=/var/www/warehouse-portal-data/uploads

# ------------------------------------------------------------------------------
# 🌱 INITIAL SEED CONFIGURATION (Optional - for first-time DB initialization)
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@warehouse.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
